{
  "name": "executeur-algorithmes",
  "productName": "Exécuteur d'algorithmes",
  "version": "1.0.1",
  "description": "Écrire, exécuter pas à pas et visualiser des algorithmes en français.",
  "author": "Exécuteur d'algorithmes",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win nsis --x64 && electron-builder --win nsis --ia32",
    "dist:mac": "node prepare.js && electron-builder --mac dmg --x64 --arm64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.executeur.algorithmes",
    "productName": "Exécuteur d'algorithmes",
    "copyright": "Exécuteur d'algorithmes",
    "files": ["main.js", "preload.js", "app/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "ExecuteurAlgorithmes"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Exécuteur d'algorithmes",
      "uninstallDisplayName": "Exécuteur d'algorithmes",
      "installerLanguages": ["fr_FR"],
      "language": "1036",
      "artifactName": "Executeur-algorithmes-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Executeur-algorithmes-Mac-${arch}.${ext}",
      "title": "Exécuteur d'algorithmes"
    },
    "afterPack": "build/adhoc-sign.js",
    "fileAssociations": [
      {
        "ext": "algo",
        "name": "Algorithme",
        "description": "Algorithme (Exécuteur d'algorithmes)",
        "role": "Editor",
        "icon": "file"
      }
    ]
  }
}
